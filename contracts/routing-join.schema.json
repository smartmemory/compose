            {
              "properties": {
                "callIdSource": {
                  "const": "absent"
                },
                "callId": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "callIdSource": {
                  "const": "connector-invocation"
                },
                "callId": {
                  "type": "string",
                  "minLength": 1,
                  "not": {
                    "pattern": "^(legacy:|compose:|engine:)"
                  }
                }
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "issuanceId": {
                  "type": "string",
                  "minLength": 1
                },
                "observationId": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "issuanceId": {
                  "type": "null"
                },
                "observationId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "route-metadata"
              }
            }
          },
          "then": {
            "properties": {
              "issuanceId": {
                "type": "string",
                "minLength": 1
              },
              "issuanceToken": {
                "type": "string",
                "minLength": 1
              },
              "observationId": {
                "type": "null"
              },
              "intentId": {
                "type": "null"
              },
              "callId": {
                "type": "null"
              },
              "parentRecordId": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "intentId": {
                "type": "string",
                "minLength": 1
              },
              "callId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
