{
  "version": 2,
  "externalPrefixes": [
    "STRAT-"
  ],
  "capabilities": {
    "stratum": true,
    "lifecycle": true,
    "guard": true
  },
  "routing": {
    "mode": "shadow"
  },
  "agents": {
    "claude": {
      "detected": true,
      "skillInstalled": true
    },
    "codex": {
      "detected": true,
      "skillInstalled": true
    },
    "gemini": {
      "detected": true,
      "skillInstalled": false
    }
  },
  "paths": {
    "docs": "docs",
    "features": "docs/features",
    "journal": "docs/journal",
    "context": "docs/context",
    "ideabox": "docs/product/ideabox.md"
  },
  "checkpoint": {
    "enabled": true,
    "backend": "jsonl",
    "confidenceThreshold": 0.6
  },
  "smartmemory": {
    "enabled": true,
    "baseUrl": "http://localhost:9001",
    "workspaceId": "team_11bc48bd9bc3",
    "apiKeyEnv": "COMPOSE_SM_KEY",
    "timeoutMs": 15000
  },
  "codegraph": {
    "repos": [
      {
        "name": "compose",
        "root": "."
      },
      {
        "name": "stratum",
        "root": "../stratum/ts"
      }
    ]
  },
  "wiki": {
    "enabled": true,
    "tokenEnv": "WIKI_OWNER_TOKEN"
  },
  "fleet": {
    "paused": [
      "hub",
      "setup",
      "trader"
    ],
    "projects": [
      "2.0",
      "hub",
      "forge",
      "wiki",
      "main",
      "trader",
      "maya",
      "bench",
      "cadence",
      "codegen",
      "mcp",
      "ops",
      "setup",
      "sm20",
      "web"
    ]
  },
  "projects": {
    "roots": [
      "~/reg/my/SmartMemory",
      "~/reg/my/forge",
      "~/reg/my/stock/trader"
    ]
  },
  "verify": {
    "flows": [
      {
        "id": "pipeline-roundtrip",
        "command": [
          "node",
          "scripts/flows/pipeline-roundtrip.mjs"
        ],
        "covers": [
          "src/lib/pipeline-model.js",
          "src/components/vision/**",
          "server/pipeline-routes.js",
          "pipelines/*.stratum.yaml"
        ],
        "expect": [
          "EDGES build 18",
          "EDGES bug-fix 8",
          "EDGES total 62",
          "EDIT build 19",
          "KEY after"
        ],
        "timeout_s": 300,
        "setup_exit_codes": [
          3,
          127
        ]
      },
      {
        "id": "builder-save-blur",
        "command": [
          "node_modules/.bin/playwright",
          "test",
          "--config",
          "e2e/playwright.config.js",
          "e2e/builder-save-blur.spec.js"
        ],
        "covers": [
          "src/components/cockpit/StratumBuilderPane.jsx",
          "server/stratum-spec-routes.js"
        ],
        "expect": [
          "RELOADED id=renamed-step"
        ],
        "timeout_s": 300,
        "setup_exit_codes": [
          3,
          127
        ]
      }
    ]
  }
}
