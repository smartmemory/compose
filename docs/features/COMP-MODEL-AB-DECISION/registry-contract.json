        "upliftNullReason": null, "promotion": null,
        "sourceRunIds": ["debug-grid-1-sonnet-std-r1", "debug-grid-1-sonnet-std-r2", "debug-grid-1-sonnet-std-r3"],
        "experimentId": "debug-grid-1", "generatedAt": "2026-10-20T13:00:00.000Z"
      }
