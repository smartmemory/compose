    {
      "name": "triaged LOW_N row",
      "validatesAgainst": "#/$defs/row",
      "value": {
        "rowId": "row-debug-sol-std-1", "stage": "debug",
        "cellKey": "debug|codex|gpt-6.1-sol|high|default",
        "compatKey": "f0b3e6d5424eff3d249d7dd1c1b8f6700624e3a6377ac84c596f04d757abb47d",
        "ingredients": { "provider": "codex", "modelID": "gpt-6.1-sol", "effort": "high", "workflow": "default" },
        "catalogDigest": "25c0c6e165cd0b9d6d941ac80b3c92814ace97dcddf2cca5c68984586bd5c1a0",
        "fixtureId": "debug-notes-search-1",
        "fixtureDigest": "dc7eaefc6e995958b82ed3c995607e18a35af896c3ab2a6d17dc4c501cc5a6a8",
        "archetypeVersion": "1", "oracleVersion": "1",
        "state": "triaged", "triageReason": "LOW_N", "nAttempted": 3, "nAdmitted": 2,
