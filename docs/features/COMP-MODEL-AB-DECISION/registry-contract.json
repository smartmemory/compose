        "ingredients": { "provider": "claude", "modelID": "claude-sonnet-5-5", "effort": "standard", "workflow": "default" },
        "catalogDigest": "25c0c6e165cd0b9d6d941ac80b3c92814ace97dcddf2cca5c68984586bd5c1a0",
        "fixtureId": "debug-notes-search-1",
