  ],

  "negativeExamples": [
    {
      "name": "run with canaryOk false (not admitted, so it cannot count toward a measured row)",
      "mustFailAgainst": "#/$defs/admittedRun",
      "value": { "metrics": { "outcome": { "completed": true }, "stage": { "accuracy": 1, "canaryOk": false, "mechanismEngaged": true, "oracleError": null } } }
    },
    {
      "name": "run with an oracleError (not admitted)",
      "mustFailAgainst": "#/$defs/admittedRun",
      "value": { "metrics": { "outcome": { "completed": true }, "stage": { "accuracy": null, "canaryOk": true, "mechanismEngaged": true, "oracleError": "suite did not start" } } }
    },
    {
      "name": "measured row with nAdmitted 2",
      "mustFailAgainst": "#/$defs/row",
      "value": { "rowId": "bad-1", "stage": "debug", "cellKey": "k", "compatKey": "f0b3e6d5424eff3d249d7dd1c1b8f6700624e3a6377ac84c596f04d757abb47d", "ingredients": { "provider": "claude", "modelID": "m", "effort": "e", "workflow": "default" }, "catalogDigest": "25c0c6e165cd0b9d6d941ac80b3c92814ace97dcddf2cca5c68984586bd5c1a0", "fixtureId": "f", "fixtureDigest": "dc7eaefc6e995958b82ed3c995607e18a35af896c3ab2a6d17dc4c501cc5a6a8", "archetypeVersion": "1", "oracleVersion": "1", "state": "measured", "triageReason": null, "nAttempted": 2, "nAdmitted": 2, "vector": { "accuracy": { "median": 1, "min": 1, "max": 1 }, "tokensIn": { "median": 1, "min": 1, "max": 1 }, "tokensOut": { "median": 1, "min": 1, "max": 1 }, "usd": null, "wallMs": { "median": 1, "min": 1, "max": 1 }, "reliability": { "median": 1, "min": 1, "max": 1 } }, "uplift": null, "upliftNullReason": null, "promotion": null, "sourceRunIds": ["r1"], "experimentId": "e", "generatedAt": "2026-10-20T13:00:00.000Z" }
    },
